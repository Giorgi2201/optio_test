{
  "name": "optio",
  "version": "1.0.0",
  "description": "Fault-tolerant dual-sink data replication platform",
  "private": true,
  "main": "scripts/migrate.js",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm --workspace=@optio/shared run build",
    "build:shared": "npm --workspace=@optio/shared run build",
    "test": "npm --workspace=@optio/pipeline run test && npm --workspace=@optio/consumer run test && node --test scripts/verify/__tests__/*.spec.js",
    "test:pipeline": "npm --workspace=@optio/pipeline run test",
    "test:consumer": "npm --workspace=@optio/consumer run test",
    "test:verify": "node --test scripts/verify/__tests__/*.spec.js",
    "typecheck": "tsc --noEmit && npm --workspace=@optio/shared run typecheck && npm --workspace=@optio/pipeline run typecheck && npm --workspace=@optio/consumer run typecheck && npm --workspace=@optio/ui run typecheck",
    "typecheck:shared": "npm --workspace=@optio/shared run typecheck",
    "ui:dev": "npm --workspace=@optio/ui run dev",
    "ui:build": "npm --workspace=@optio/ui run build",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "seed:dry": "node scripts/seed.js --dry-run",
    "seed:fresh": "node scripts/seed.js --fresh",
    "probe": "node scripts/env-probe.js",
    "verify": "node scripts/verify/index.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
