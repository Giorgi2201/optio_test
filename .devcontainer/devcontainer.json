{
  "name": "OPTIO Replication Platform (Codespaces / Devcontainer)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": true
    }
  },
  "forwardPorts": [
    5432,
    9200,
    5672,
    15672,
    3000,
    4000
  ],
  "portsAttributes": {
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "notify"
    },
    "9200": {
      "label": "Elasticsearch",
      "onAutoForward": "notify"
    },
    "5672": {
      "label": "RabbitMQ AMQP",
      "onAutoForward": "silent"
    },
    "15672": {
      "label": "RabbitMQ Management UI",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Pipeline / Metrics API",
      "onAutoForward": "openBrowser"
    },
    "4000": {
      "label": "Operational UI Dashboard",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postCreateCommand": "echo '== OPTIO Devcontainer ready with Docker-in-Docker support =='"
}