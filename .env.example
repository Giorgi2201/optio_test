# ==============================================================================
# OPTIO REPLICATION PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# PostgreSQL Configuration (Primary Source, Watermarks & DLQ)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=optio_replication
POSTGRES_USER=optio
POSTGRES_PASSWORD=optio_secure_pass
DATABASE_URL=postgresql://optio:optio_secure_pass@localhost:5432/optio_replication

# Elasticsearch Configuration (Sink 1 - Search & Current State Store)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=records_search_index

# RabbitMQ Configuration (Sink 2 - Event Stream Broker)
RABBITMQ_URL=amqp://optio:optio_secure_pass@localhost:5672
RABBITMQ_DEFAULT_USER=optio
RABBITMQ_DEFAULT_PASS=optio_secure_pass
RABBITMQ_EXCHANGE=replication.events
RABBITMQ_QUEUE=replication.events.queue
RABBITMQ_DLQ_EXCHANGE=replication.dlq.exchange
RABBITMQ_DLQ_QUEUE=replication.dlq.queue

# Replication Daemon Pipeline Tuning
PIPELINE_BATCH_SIZE=500
PIPELINE_POLL_INTERVAL_MS=1000
